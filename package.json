{
  "name": "digsight",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "github:AyingAI/digsight",
  "files": [
    "src/**/*.ts",
    "src/report/reading.css",
    "web/app.css",
    "web/app.js",
    "web/index.html",
    "docs/cover.jpg",
    "docs/research-report-writing.md"
  ],
  "type": "module",
  "description": "Multi-agent research workbench built on the pi SDK with ego-browser web-agent collection",
  "scripts": {
    "start": "node src/server.ts",
    "serve": "node src/server.ts",
    "run": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node --check web/app.js && npm test",
    "test": "node --test tests/*.test.ts",
    "rebuild": "node src/rebuild-report.ts",
    "doctor": "node src/cli.ts doctor",
    "setup": "pi"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "marked": "^18.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=23.6"
  }
}
